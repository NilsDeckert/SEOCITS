  shorttitle = {Vision-and-{{Language Navigation}}},
  author = {Anderson, Peter and Wu, Qi and Teney, Damien and Bruce, Jake and Johnson, Mark and S{\"u}nderhauf, Niko and Reid, Ian and Gould, Stephen and van den Hengel, Anton},
