@misc{zengLargeLanguageModels2025,
  title = {Large {{Language Models}} for {{Robotics}}: {{A Survey}}},
  shorttitle = {Large {{Language Models}} for {{Robotics}}},
  author = {Zeng, Fanlong and Gan, Wensheng and Huai, Zezheng and Sun, Lichao and Chen, Hechang and Wang, Yongheng and Liu, Ning and Yu, Philip S.},
